---
import AddToCart from './AddToCart.vue';
import Badge from './Badge.astro';
import { getCourseDetails, toCartItem, type Course } from '../lib/courses';
import { formatMinutes, formatNumber, formatPrice, levelLabels, levelTones } from '../lib/format';

interface Props {
  course: Course;
  enrolled?: boolean;
  /** در صفحه‌ی مدرس، نام مدرس تکراری است */
  showInstructor?: boolean;
}

const { course, enrolled = false, showInstructor = true } = Astro.props;
const { instructor, lessons, minutes } = await getCourseDetails(course);
---
<article class="grid gap-4 py-6 sm:grid-cols-[1fr_auto] sm:items-center">
  <div>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <Badge tone={levelTones[course.data.level]}>{levelLabels[course.data.level]}</Badge>
      <span class="text-muted">{formatNumber(lessons.length)} درس، {formatMinutes(minutes)}</span>
    </div>
    <h3 class="mt-2 text-xl font-bold">
      <a href={`/courses/${course.id}`} class="hover:text-firoozeh-dark">{course.data.title}</a>
    </h3>
    <p class="mt-1 max-w-prose text-muted">{course.data.summary}</p>
    {showInstructor && (
      <p class="mt-2 text-sm">
        با تدریس <a href={`/instructors/${instructor.id}`} class="underline decoration-line underline-offset-4 hover:text-firoozeh-dark hover:decoration-firoozeh">{instructor.data.name}</a>
      </p>
    )}
  </div>
  <div class="flex items-center gap-4 sm:flex-col sm:items-end">
    <span class="font-bold tabular-nums">{formatPrice(course.data.price)}</span>
    <AddToCart client:visible course={toCartItem(course)} enrolled={enrolled} />
  </div>
</article>
