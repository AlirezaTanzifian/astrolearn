---
import type { HTMLAttributes } from 'astro/types';
import { buttonClass, type ButtonSize, type ButtonVariant } from '../lib/ui';

type Props = (HTMLAttributes<'a'> & HTMLAttributes<'button'>) & {
  href?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
};

const { href, variant, size, class: className, type = 'button', ...rest } = Astro.props;
const classes = [buttonClass(variant, size), className];
---
{href
  ? <a href={href} class:list={classes} {...rest}><slot /></a>
  : <button type={type} class:list={classes} {...rest}><slot /></button>}
