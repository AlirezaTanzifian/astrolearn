---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import CourseRow from '../components/CourseRow.astro';
import { getEnrolled } from '../lib/enrollment';

export const prerender = false;

const enrolledIds = await getEnrolled(Astro.session);
const courses = await getCollection('courses', ({ id }) => enrolledIds.includes(id));
const welcome = Astro.url.searchParams.has('welcome');
---
<MainLayout title="دوره‌های من">
  <h1 class="font-display text-4xl">دوره‌های من</h1>

  {welcome && courses.length > 0 && (
    <p role="status" class="mt-6 rounded-xl bg-firoozeh/10 px-5 py-4 font-medium text-firoozeh-dark">
      ثبت‌نام انجام شد. همه‌ی درس‌های این دوره‌ها حالا باز است.
    </p>
  )}

  {courses.length ? (
    <div class="mt-4 divide-y divide-line">
      {courses.map((course) => <CourseRow course={course} enrolled />)}
    </div>
  ) : (
    <div class="mt-8 rounded-2xl border border-dashed border-line bg-white px-6 py-12 text-center">
      <p class="font-semibold">هنوز در دوره‌ای ثبت‌نام نکرده‌اید.</p>
      <a href="/courses" class="mt-3 inline-block text-firoozeh-dark hover:underline">دیدن دوره‌ها</a>
    </div>
  )}
</MainLayout>
