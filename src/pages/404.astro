---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
---
<MainLayout title="صفحه پیدا نشد">
  <div class="py-16 text-center">
    <h1 class="font-display text-5xl">این صفحه وجود ندارد</h1>
    <p class="mt-4 text-muted">ممکن است آدرس اشتباه تایپ شده باشد یا دوره حذف شده باشد.</p>
    <Button href="/courses" class="mt-8">دیدن دوره‌ها</Button>
  </div>
</MainLayout>
