---
import MainLayout from '../layouts/MainLayout.astro';
import AddToCart from '../components/AddToCart.vue';
import { getCollection } from 'astro:content';

// دریافت تمام دوره‌ها در زمان بیلد/سرور
const courses = await getCollection('courses');
---

<MainLayout title="لیست دوره‌ها">
  <h1 class="text-3xl font-bold mb-6">دوره‌های آموزشی</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {courses.map((course) => (
      <div class="border p-5 rounded-xl bg-white shadow-sm hover:shadow-md transition">
        <h2 class="text-xl font-bold mb-2">
          <a href={`/courses/${course.id}`}>{course.data.title}</a>
        </h2>
        <p class="text-gray-600 mb-4">مدرس: {course.data.instructor}</p>
        <div class="flex justify-between items-center">
          <span class="font-bold text-green-600">{course.data.price} تومان</span>
          
          <!-- استفاده از Island Architecture با client:load -->
          <AddToCart 
            client:load 
            course={{ id: course.id, title: course.data.title, price: course.data.price }} 
          />
        </div>
      </div>
    ))}
  </div>
</MainLayout>