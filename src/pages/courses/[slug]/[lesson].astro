---
import { getEntry, render } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import AddToCart from '../../../components/AddToCart.vue';
import LessonToggle from '../../../components/LessonToggle.vue';
import { getLessons, lessonSlug, toCartItem } from '../../../lib/courses';
import { getEnrolled } from '../../../lib/enrollment';
import { formatMinutes, formatNumber } from '../../../lib/format';

export const prerender = false;

const { slug, lesson: lessonParam } = Astro.params;
const course = await getEntry('courses', slug!);
const lesson = await getEntry('lessons', `${slug}/${lessonParam}`);
if (!course || !lesson) return new Response(null, { status: 404 });

// درس‌های غیررایگان فقط برای کاربران ثبت‌نام‌شده باز است (بررسی روی سرور)
const enrolled = (await getEnrolled(Astro.session)).includes(course.id);
const locked = !lesson.data.free && !enrolled;
const { Content } = locked ? { Content: null } : await render(lesson);

const lessons = await getLessons(course.id);
const index = lessons.findIndex((l) => l.id === lesson.id);
const prev = lessons[index - 1];
const next = lessons[index + 1];
---
<MainLayout title={`${lesson.data.title} | ${course.data.title}`}>
  <a href={`/courses/${course.id}`} class="text-sm text-muted hover:text-ink">{course.data.title}</a>

  <article class="mx-auto mt-4 max-w-2xl">
    <p class="text-sm text-muted">
      درس {formatNumber(lesson.data.order)} از {formatNumber(lessons.length)}، {formatMinutes(lesson.data.minutes)}
    </p>
    <h1 class="mt-2 font-display text-4xl leading-tight">{lesson.data.title}</h1>

    {Content ? (
      <>
        <div class="mt-8 aspect-video rounded-2xl bg-ink grid place-items-center text-white/70">ویدیوی درس</div>
        <div class="prose prose-lg mt-8 max-w-none prose-code:before:content-none prose-code:after:content-none">
          <Content />
        </div>
        <div class="mt-10">
          <LessonToggle client:load lessonId={lesson.id} />
        </div>
      </>
    ) : (
      <div class="mt-8 rounded-2xl border border-line bg-white p-8 text-center">
        <p class="text-lg font-semibold">این درس برای شرکت‌کنندگان دوره باز است.</p>
        <p class="mt-2 text-muted">با ثبت‌نام در دوره به همه‌ی درس‌ها دسترسی پیدا می‌کنید.</p>
        <div class="mt-6 flex justify-center">
          <AddToCart client:load course={toCartItem(course)} />
        </div>
      </div>
    )}

    <nav class="mt-12 flex justify-between gap-4 border-t border-line pt-6 text-sm">
      {prev ? <a href={`/courses/${course.id}/${lessonSlug(prev)}`} class="hover:text-firoozeh-dark">درس قبلی: {prev.data.title}</a> : <span />}
      {next && <a href={`/courses/${course.id}/${lessonSlug(next)}`} class="hover:text-firoozeh-dark">درس بعدی: {next.data.title}</a>}
    </nav>
  </article>
</MainLayout>
